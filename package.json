{
  "name": "firecrackers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "tsc -p tsconfig.engine.json && node --test tests/engine.test.mjs",
    "test:soak": "tsc -p tsconfig.engine.json && node tests/soak.mjs",
    "test:e2e": "playwright test",
    "build": "node scripts/generate-icons.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "lucide-react": "0.469.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@types/node": "22.18.6",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vite": "6.3.6",
    "vite-plugin-pwa": "1.0.3"
  }
}
