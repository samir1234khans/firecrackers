{
  "name": "firecrackers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "tsc -p tsconfig.engine.json && node --test tests/engine.test.mjs tests/v2.test.mjs tests/realism-v3.test.mjs tests/video-flow.test.mjs tests/release-fingerprint.test.mjs tests/renderer-recovery.test.mjs",
    "test:soak": "tsc -p tsconfig.engine.json && node tests/soak.mjs",
    "test:e2e": "node tests/video-flow-browser.mjs",
    "build": "node scripts/generate-icons.mjs && node scripts/generate-notices.mjs && node scripts/generate-release.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:video-flow": "tsc -p tsconfig.engine.json && node --test tests/video-flow.test.mjs",
    "test:viewability": "node tests/viewability-browser.mjs"
  },
  "dependencies": {
    "lucide-react": "0.469.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@types/node": "22.18.6",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.0.3"
  }
}
