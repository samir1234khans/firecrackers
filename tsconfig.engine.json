{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": ".test-build",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": [
    "src/engine/catalog.ts",
    "src/platform/preferences.ts",
    "src/engine/Pool.ts",
    "src/engine/Simulation.ts",
    "src/engine/Trails.ts",
    "src/platform/PauseIntent.ts",
    "src/platform/WakeLockController.ts",
    "src/platform/presentation.ts",
    "src/engine/QualityGovernor.ts",
    "src/engine/VisibleFrame.ts",
    "src/engine/RendererRecovery.ts",
    "src/engine/StartupProgress.ts",
    "src/engine/SkyState.ts",
    "src/graphics/CelestialScene.ts",
    "src/graphics/MoonComposition.ts",
    "src/graphics/WaterWaves.ts",
    "src/graphics/PlanarReflection.ts",
    "src/graphics/WaterReflection.ts",
    "src/graphics/ParticleReflectionBounds.ts",
    "src/engine/SmokeCanopy.ts",
    "src/engine/SoundProfiles.ts",
    "src/engine/RenderBudget.ts",
    "src/experience/ShowRecipe.ts",
    "src/experience/NightLibrary.ts",
    "src/experience/SceneCapture.ts",
    "src/experience/SessionDiagnostics.ts",
    "src/engine/SmokeOcclusion.ts"
  ]
}
